{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birthday-card",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/c/*"]
  },
  "r2_buckets": [
    {
      "binding": "CARDS",
      "bucket_name": "birthday-card-cards"
    }
  ],
  "observability": {
    "enabled": true
  }
}
