{
  "name": "birthday-card",
  "version": "0.1.0",
  "private": true,
  "description": "Handwrite a birthday card on your iPad, share it as a link, and let them watch it unfold.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.ts",
    "dev:cf": "vite build && wrangler dev",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.127.1"
  }
}
